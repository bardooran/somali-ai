{"id":"ORTH-PUNCT-001","category":"sentence_punctuation","mark":".","use":"declarative_sentence_end","status":"provisional","source":"SLS resources/qoraal/05-astaamaynta.md","note":"Use a full stop when an ordinary declarative sentence ends."}
{"id":"ORTH-PUNCT-002","category":"sentence_punctuation","mark":"?","use":"question_sentence_end","status":"provisional","source":"SLS resources/qoraal/05-astaamaynta.md","note":"Use a question mark when an interrogative sentence ends."}
{"id":"ORTH-PUNCT-003","category":"sentence_punctuation","mark":"!","use":"exclamation_sentence_end","status":"provisional","source":"SLS resources/qoraal/05-astaamaynta.md","note":"Use an exclamation mark for an exclamatory utterance."}
{"id":"ORTH-PUNCT-004","category":"internal_punctuation","mark":",","use":"list_separator","status":"provisional","source":"SLS resources/qoraal/05-astaamaynta.md","note":"Comma can separate coordinated items in a list."}
