{"id":"QLEX-GRAM-001","lemma":"diirad","homograph_index":2,"source_pos":"m.dh","domain":"naxwe","somali_definition_summary":"Qaybta weerta ee hadluhu si gaar ah u danaynayo ama u soo bandhigayo sida xogta la xoojiyey; calaamado sida baa/ayaa ama waa ayaa la xiriira diiradaynta.","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-002","lemma":"diiradeeye","source_pos":"m.l","domain":"naxwe","somali_definition_summary":"Qurub loo adeegsado diiradaynta qayb ka mid ah weerta; Qaamuusku wuxuu magacaabaa baa/ayaa iyo waa.","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-003","lemma":"magacuyaal","source_pos":"m.l","plural_source":"-llo, m.dh","domain":"naxwe","somali_definition_summary":"Qayb hadalka ka mid ah oo magac beddesha. Qaamuusku wuxuu kala saaraa magacuyaal ebyoon oo keligood istaagi kara iyo kuwo dhimman oo aan qodob qaadan karin.","source_examples":{"independent":["aniga","adiga"],"reduced":["i","na","ku","idin"]},"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-004","lemma":"fal","homograph_index":2,"source_pos":"m.l","domain":"naxwe","somali_definition_summary":"Qayb naxweed isrogrogta oo tilmaamaysa wax la sameeyo ama xaalad/ahaansho. Qaamuusku gudaha gelitaanka wuxuu kala xusaa gudbe, magudbe iyo fal-sifo.","source_examples":["Guuleed wuu yimid","Sucaad way kortay"],"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-005","lemma":"gudbe","homograph_index":2,"source_pos":"m.l.kh","domain":"naxwe","somali_definition_summary":"Fal waxqabadkiisu u gudbo wax kale oo u baahan yeele iyo layeele.","source_example":"Cali baa aqalkii dhisay","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-006","lemma":"magudbe","homograph_index":2,"source_pos":"m.l","domain":"naxwe","somali_definition_summary":"Fal aan lahayn layeele.","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-007","lemma":"yeele","source_pos":"m.l","plural_source":"-layaal, m.l/dh","domain":"naxwe","somali_definition_summary":"Magaca waafaqsan qaab-sarfeedka falka weerta; Qaamuusku sidoo kale xusaa magaca fale.","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-008","lemma":"baa","source_pos":"qr.dd","domain":"naxwe","somali_definition_summary":"Qurub diiradeed oo tilmaama halka diiraddu kaga jirto weerta, gaar ahaan qayb magaceed.","source_examples":["Ma Cali baa yimid?","Haa, Cali baa yimid"],"variants_from_source":["aa","ayaa","yaa"],"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed","execution_note":"Do not infer semantic roles from baa alone; sentence context remains required."}
{"id":"QLEX-GRAM-009","lemma":"ka","homograph_index":1,"source_pos":"mu.ti.l","domain":"naxwe","somali_definition_summary":"Magacuyaal tilmaame lab ah oo qof ama wax hadlaha u dhow tilmaama.","plural_source":"kuwa","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-010","lemma":"ka","homograph_index":2,"source_pos":"h","domain":"naxwe","somali_definition_summary":"Horyaale/qurub ka hor falka oo Qaamuusku u adeegsado macnayaal ay ka mid yihiin il/meel laga dhaqaaqo, barbardhig, iyo meel fal ka dhaco ama laga gudbo.","source_examples":["Balcad ayuu ka yimid","Marka waxaa ka weyn Xamar","Halkaas buu guri ka dhisay"],"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-011","lemma":"ka","homograph_index":3,"source_pos":"q.l","domain":"naxwe","somali_definition_summary":"Qodobka magaca lab lagu cayimo; Qaamuusku wuxuu xusaa faracyo/surface forms -ga, -ha iyo -a iyadoo ku xiran magaca.","source_examples":["nin+ka→ninka","buug+ka→buugga"],"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-012","lemma":"kee","homograph_index":1,"source_pos":"mu.we.l","domain":"naxwe","somali_definition_summary":"Magacuyaal weyddiimeed lab ah oo iskii u taagan, laguna hubsado qof ama wax.","plural_source":"kuwee","source_example":"Waa kee midka aaday xafiiska?","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-013","lemma":"kee","homograph_index":2,"source_pos":"dk.we.l","domain":"naxwe","somali_definition_summary":"Dibkabe weyddiimeed lab ah oo magaca ku lifaaqa su'aal hubsasho.","source_example":"Wiilkee baa kula hadlay?","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-014","lemma":"keen","homograph_index":1,"source_pos":"mu.dhm.ly","domain":"naxwe","somali_definition_summary":"Magacuyaal layeele qofka koowaad ee wadarta mideeya; kuwa lala hadlayo ayaa ku jira kooxda la tilmaamayo.","source_example":"Cali baa isugu keen yeeray","english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed"}
{"id":"QLEX-GRAM-015","lemma":"ba","source_pos":"qr","domain":"naxwe","somali_definition_summary":"Qurub leh adeegyo dhowr ah sida adkaynta diidmada, mid-kasta/wax-kasta, xataa, iyo shaqooyin kale oo macne/diirad ku kordhiya weedha.","source_examples":["Waxba ma aha","Nimba si ayuu u qaatay","Aniguba waan arkay"],"english_gloss":null,"english_status":"not_from_qaamuus","source":"Qaamuuska Af-Soomaaliga (Puglielli & Mansuur, 2012)","status":"source_backed","execution_note":"Polyfunctional particle; analyze by sentence context."}
